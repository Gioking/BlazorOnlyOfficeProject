@inherits LayoutComponentBase

<div class="d-flex vh-100">
    <nav class="sidebar bg-dark-gradient d-flex flex-column p-0">
        <div class="sidebar-header p-3 text-white border-bottom border-secondary">
            <h4 class="mb-0">📄 OnlyOffice Blazor</h4>
        </div>
        <NavMenu />
    </nav>

    <main class="flex-grow-1 d-flex flex-column">
        <div class="top-bar bg-dark-subtle border-bottom border-secondary px-4 py-3">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0 text-white">Editor Documenti</h5>
                <span class="badge bg-primary">Online</span>
            </div>
        </div>

        <article class="content flex-grow-1 p-4 overflow-auto">
            @Body
        </article>
    </main>
</div>

